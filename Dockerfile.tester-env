# syntax=docker/dockerfile:1
# GoatCounter tester-env image: editable-source build with dependency caching.
#
# Layer order caches `go mod download` separately from app source, so small
# source mutations only re-run the final `go build` (~1-2 min incremental)
# instead of re-fetching all modules. GOCACHE/GOMODCACHE use BuildKit cache
# mounts shared across builds of the same builder.
FROM docker.io/golang:1.25-bookworm AS build
WORKDIR /src

# Dependency layer: invalidated only when go.mod/go.sum change.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Source layer: mutations invalidate only this layer + the build below.
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go build -trimpath -buildvcs=false \
        -ldflags='-s -w -extldflags=-static' \
        -tags='osusergo,netgo,sqlite_omit_load_extension' \
        -o /out/goatcounter \
        ./cmd/goatcounter

FROM docker.io/alpine:3.21
COPY --from=build /out/goatcounter /bin/goatcounter
RUN set -euC; \
    addgroup -S goatcounter; \
    adduser -S -G goatcounter goatcounter; \
    mkdir -p /home/goatcounter/goatcounter-data; \
    chown goatcounter:goatcounter /home/goatcounter/goatcounter-data
EXPOSE 8080
WORKDIR /home/goatcounter
USER goatcounter:goatcounter
VOLUME ["/home/goatcounter/goatcounter-data"]
ENTRYPOINT ["goatcounter"]
CMD ["serve", "-automigrate", "-listen", ":8080", "-tls", "http"]
